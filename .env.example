# Mode: True = paper trading (virtual $10,000), False = LIVE with real money
PAPER_TRADING=True

# Bybit API (permission: Read + Trade ONLY, never Withdrawal; whitelist your IP)
API_KEY=
SECRET=

# Telegram notifications (optional)
TELEGRAM_TOKEN=
CHAT_ID=

# Smart money data (optional - without keys those components stay neutral)
CRYPTOQUANT_KEY=
COINGLASS_KEY=

# Dashboard (optional access token; strongly recommended if the port is public)
DASHBOARD_PORT=5000
DASHBOARD_TOKEN=

# Bybit domain: change to bybit.nl if bybit.com is unreachable from your network
# BYBIT_DOMAIN=bybit.com

# Optional overrides
# SCANNER_TOP_N=80          # jumlah pair USDT perpetual teratas (by volume) yang dipantau di tab Market
# SCANNER_ANALYZE_N=50      # dari itu, berapa yang dianalisis teknikal 1H (RSI, EMA, ADX, volume)
# SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,HYPE/USDT
# LEVERAGE=5
# PAPER_BALANCE=10000
